{
  "name": "seamfox-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint",
    "lint:fix": "eslint --no-ignore --fix && prettier --write .",
    "lint:watch": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') require('child_process').execSync('husky install', { stdio: 'inherit' })\""
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix || true",
      "prettier --write ."
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",

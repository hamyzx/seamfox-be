{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [                          
      "lib/constants/*.json",            
      "lib/constants/**/*.json"
    ],
    "watchAssets": true
  }
}